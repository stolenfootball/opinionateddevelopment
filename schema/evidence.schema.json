{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/evidence-v1.json",
  "title": "OpDev evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": { "const": 1 },
    "project": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "work", "assertions"],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "work": { "type": "string", "minLength": 1 },
          "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "outcome", "summary", "evidence"],
      "properties": {
        "rule_id": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+-[0-9]{3}$" },
        "outcome": { "enum": ["passed", "not_applicable"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "location": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
