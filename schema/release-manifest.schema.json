{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opdev.dev/schema/release-manifest-v1.json",
  "title": "OpDev release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_uri", "source_revision", "builder_id", "artifacts", "sbom", "assurance_limitation"],
  "properties": {
    "schema": { "const": 1 },
    "source_uri": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "builder_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/digest" }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "format", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "format": { "const": "CycloneDX" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "assurance_limitation": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
